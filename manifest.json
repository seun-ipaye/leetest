{
  "manifest_version": 3,
  "name": "LeetTest",
  "version": "0.1.0",
  "description": "Randomized, timed LeetCode practice and OA simulation.",
  "permissions": ["sidePanel", "storage", "tabs", "alarms"],
  "host_permissions": ["https://leetcode.com/*"],
  "background": { "service_worker": "src/background/service-worker.js", "type": "module" },
  "side_panel": { "default_path": "src/sidepanel/index.html" },
  "action": { "default_title": "Open LeetTest" },
  "content_scripts": [
    { "matches": ["https://leetcode.com/problems/*"], "js": ["src/content/leetcode.js"], "run_at": "document_idle" }
  ]
}
